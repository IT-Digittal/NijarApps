# =============================================================
# Plataforma DTI Níjar - Variables de entorno (ejemplo)
# =============================================================
# Copia este fichero a .env y rellena los valores reales.
# El fichero .env NO debe subirse al repositorio.

# --- Aplicación ---
APP_NAME="Plataforma DTI Níjar"
APP_ENV=development           # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-32-bytes-of-randomness
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Base de datos PostgreSQL/PostGIS ---
DATABASE_URL=postgresql+asyncpg://nijar:nijar_dev_pwd@db:5432/nijar_dti
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis (cache + pub/sub) ---
REDIS_URL=redis://redis:6379/0
REDIS_TTL_DEFAULT=300

# --- MQTT (ingesta IoT) ---
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=nijar-dti-platform
MQTT_TOPIC_SENSORS=nijar/sensors/+/observation
MQTT_TOPIC_PATTERN=nijar/sensors/+/+
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_USE_TLS=false
MQTT_TLS_CA_CERT=
MQTT_TLS_CLIENT_CERT=
MQTT_TLS_CLIENT_KEY=
MQTT_RECONNECT_DELAY_MIN_SECONDS=1
MQTT_RECONNECT_DELAY_MAX_SECONDS=60

# --- Conectores externos (placeholders) ---
# Web turística municipal
WEB_NIJAR_API_URL=
WEB_NIJAR_API_TOKEN=

# App Vive Níjar
APP_VIVE_NIJAR_API_URL=
APP_VIVE_NIJAR_API_TOKEN=

# Estaciones meteorológicas
METEO_API_URL=
METEO_API_KEY=

# --- Social Listening - X / Twitter API v2 ---
TWITTER_BEARER_TOKEN=
TWITTER_SEARCH_QUERY=Cabo de Gata OR Níjar OR "Playa de Mónsul"
TWITTER_MAX_RESULTS_PER_POLL=50

# --- Social Listening - Facebook & Instagram Graph API ---
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_HASHTAGS=cabodegata,nijar,playamonsul

# --- Social Listening común ---
SOCIAL_POLLING_INTERVAL_MINUTES=15
SOCIAL_LISTENING_ENABLED=false
# DRY_RUN=true: no llama a las APIs externas, genera datos sintéticos.
# Útil para desarrollo y demos antes de obtener tokens reales.
SOCIAL_DRY_RUN=true

# --- Chatbot ---
# CHATBOT_ENGINE=lexical: motor interno por similitud (Hito 1)
# CHATBOT_ENGINE=rasa: usa servidor Rasa externo (Hito 2)
CHATBOT_ENGINE=lexical
RASA_URL=http://rasa:5005
RASA_TIMEOUT_SECONDS=8
RASA_FALLBACK_TO_LEXICAL=true

# Google Analytics 4 (eficacia digital)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# --- Almacenamiento ---
STORAGE_BACKEND=local         # local | s3 | gcs
STORAGE_LOCAL_PATH=/data/storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=eu-west-1

# --- Observabilidad ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true
