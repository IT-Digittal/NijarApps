# =============================================================
# Plataforma DTI Níjar - Variables de entorno (ejemplo)
# =============================================================
# Copia este fichero a .env y rellena los valores reales.
# El fichero .env NO debe subirse al repositorio.

# --- Aplicación ---
APP_NAME="Plataforma DTI Níjar"
APP_ENV=development           # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-32-bytes-of-randomness
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Base de datos PostgreSQL/PostGIS ---
DATABASE_URL=postgresql+asyncpg://nijar:nijar_dev_pwd@db:5432/nijar_dti
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis (cache + pub/sub) ---
REDIS_URL=redis://redis:6379/0
REDIS_TTL_DEFAULT=300

# --- MQTT (ingesta IoT) ---
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=nijar-dti-platform
MQTT_TOPIC_SENSORS=nijar/sensors/+/observation
MQTT_TOPIC_PATTERN=nijar/sensors/+/+
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_USE_TLS=false
MQTT_TLS_CA_CERT=
MQTT_TLS_CLIENT_CERT=
MQTT_TLS_CLIENT_KEY=
MQTT_RECONNECT_DELAY_MIN_SECONDS=1
MQTT_RECONNECT_DELAY_MAX_SECONDS=60

# --- Conectores externos (placeholders) ---
# Web turística municipal
WEB_NIJAR_API_URL=
WEB_NIJAR_API_TOKEN=

# App Vive Níjar
APP_VIVE_NIJAR_API_URL=
APP_VIVE_NIJAR_API_TOKEN=

# Estaciones meteorológicas
METEO_API_URL=
METEO_API_KEY=

# ============================================================
# Conexión a los perfiles oficiales del Ayuntamiento de Níjar
# ------------------------------------------------------------
# Pasos para conectar las cuentas reales (los realiza el Ayuntamiento como
# propietario de los perfiles; hasta entonces se opera en SOCIAL_DRY_RUN):
#   1. X/Twitter: crear app en el Developer Portal y obtener un Bearer Token.
#   2. Facebook: vincular la página oficial a una app de Meta y generar un
#      Page Access Token de larga duración; indicar el ID o el alias de la página.
#   3. Instagram: la cuenta debe ser Instagram Business vinculada a la página de
#      Facebook; obtener el Instagram Business Account ID.
#   4. Rellenar los tokens/IDs de abajo y poner SOCIAL_DRY_RUN=false.
# ============================================================

# --- Social Listening - X / Twitter API v2 ---
TWITTER_BEARER_TOKEN=
TWITTER_SEARCH_QUERY=Cabo de Gata OR Níjar OR "Playa de Mónsul" OR "Parque Natural Cabo de Gata" OR Rodalquilar OR "San José Almería"
TWITTER_MAX_RESULTS_PER_POLL=50

# --- Social Listening - Facebook & Instagram Graph API ---
FACEBOOK_ACCESS_TOKEN=
# ID numérico de la página oficial (recomendado). Si no se conoce, usar el alias.
FACEBOOK_PAGE_ID=
# Alias público de la página oficial del Ayuntamiento (a confirmar por el Ayto.)
FACEBOOK_PAGE_HANDLE=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Alias público de la cuenta oficial de Instagram (a confirmar por el Ayto.)
INSTAGRAM_HANDLE=
INSTAGRAM_HASHTAGS=cabodegata,nijar,playamonsul,parquenaturalcabodegata,rodalquilar,sanjosenijar

# --- Social Listening común ---
SOCIAL_POLLING_INTERVAL_MINUTES=15
SOCIAL_LISTENING_ENABLED=false
# DRY_RUN=true: no llama a las APIs externas, genera datos sintéticos.
# Útil para desarrollo y demos antes de obtener tokens reales.
SOCIAL_DRY_RUN=true

# --- Chatbot ---
# CHATBOT_ENGINE=lexical: motor interno por similitud (Hito 1)
# CHATBOT_ENGINE=rasa: usa servidor Rasa externo (Hito 2)
# CHATBOT_ENGINE=openai: IA generativa con grounding en datos de la plataforma
CHATBOT_ENGINE=lexical
RASA_URL=http://rasa:5005
RASA_TIMEOUT_SECONDS=8
RASA_FALLBACK_TO_LEXICAL=true

# Motor generativo (solo si CHATBOT_ENGINE=openai). Con fallo o sin clave,
# el asistente degrada automáticamente a Rasa y después al motor léxico.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_TOKENS=400

# Google Analytics 4 (eficacia digital)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# --- Almacenamiento ---
STORAGE_BACKEND=local         # local | s3 | gcs
STORAGE_LOCAL_PATH=/data/storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=eu-west-1

# --- Observabilidad ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true
