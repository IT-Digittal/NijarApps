{
  "title": "Nijar DTI · Smart Office",
  "uid": "nijar-smart-office",
  "tags": ["nijar", "dti", "smart-office", "iot"],
  "timezone": "Europe/Madrid",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Sensores por estado",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nijar_sensores_total", "legendFormat": "{{estado}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Observaciones recibidas (última hora)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nijar_observaciones_ultima_hora_total" }],
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "title": "% observaciones inválidas",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "100 * nijar_observaciones_invalidas_ultima_hora_total / clamp_min(nijar_observaciones_ultima_hora_total, 1)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }
          ]}
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 4,
      "title": "Sensores offline en el tiempo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nijar_sensores_total{estado=\"offline\"}" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 5,
      "title": "Observaciones por hora (últimas 24h)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "nijar_observaciones_ultima_hora_total", "legendFormat": "válidas + inválidas" },
        { "expr": "nijar_observaciones_invalidas_ultima_hora_total", "legendFormat": "inválidas" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
