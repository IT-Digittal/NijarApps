# =============================================================
# Plataforma DTI Níjar — Variables de entorno de PRODUCCIÓN (VPS OVH)
# =============================================================
# Copiar a .env en este mismo directorio (infra/ovh/) y rellenar.
# Los valores marcados con CAMBIAR son obligatorios.
# El fichero .env NO debe subirse nunca al repositorio.

# --- Despliegue (usados por docker-compose.prod.yml y Caddy) ---
DOMINIO=CAMBIAR                        # ej. dti.nijar.es (el DNS debe apuntar al VPS)
ACME_EMAIL=CAMBIAR                     # email para avisos de Let's Encrypt
POSTGRES_PASSWORD=CAMBIAR              # generar: openssl rand -base64 24
APP_VERSION=1.0.0

# --- Aplicación ---
APP_NAME="Plataforma DTI Níjar"
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Seguridad ---
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CAMBIAR
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (solo el dominio público de la plataforma) ---
CORS_ALLOWED_ORIGINS=https://CAMBIAR   # ej. https://dti.nijar.es

# --- Base de datos PostgreSQL/PostGIS ---
# La contraseña debe coincidir con POSTGRES_PASSWORD de arriba.
DATABASE_URL=postgresql+asyncpg://nijar:CAMBIAR@db:5432/nijar_dti
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_TTL_DEFAULT=300

# --- MQTT (ingesta IoT) ---
# Usuario/contraseña creados con mosquitto_passwd (ver mosquitto.prod.conf).
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USERNAME=nijar-platform
MQTT_PASSWORD=CAMBIAR
MQTT_CLIENT_ID=nijar-dti-platform
MQTT_TOPIC_SENSORS=nijar/sensors/+/observation
MQTT_TOPIC_PATTERN=nijar/sensors/+/+
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_USE_TLS=false
MQTT_RECONNECT_DELAY_MIN_SECONDS=1
MQTT_RECONNECT_DELAY_MAX_SECONDS=60

# --- Conectores externos ---
WEB_NIJAR_API_URL=
WEB_NIJAR_API_TOKEN=
APP_VIVE_NIJAR_API_URL=
APP_VIVE_NIJAR_API_TOKEN=
METEO_API_URL=
METEO_API_KEY=

# --- Social Listening ---
# Procedimiento completo para activar RRSS reales (Facebook + Instagram) en:
#   docs/integraciones/runbook-social-listening-meta.md
# Resumen: (1) rellenar los 3 valores de Meta de abajo, (2) verificar con
#   python -m scripts.verificar_social_meta   (o scripts/verificar_social_meta.py)
#   (3) poner SOCIAL_DRY_RUN=false y reiniciar el social-worker.
# Mantener SOCIAL_DRY_RUN=true hasta que la verificación pase en verde.
TWITTER_BEARER_TOKEN=
TWITTER_SEARCH_QUERY=Cabo de Gata OR Níjar OR "Playa de Mónsul" OR "Parque Natural Cabo de Gata" OR Rodalquilar OR "San José Almería"
TWITTER_MAX_RESULTS_PER_POLL=50

# Facebook: Page Access Token de larga duración (idealmente de System User, no caduca).
# Scopes necesarios: pages_read_engagement, pages_read_user_content
FACEBOOK_ACCESS_TOKEN=
# App de Meta: SOLO para renovar el token de 60 días con
# scripts/renovar_token_facebook.py (no hacen falta con System User).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# ID numérico de la página oficial del Ayuntamiento (GET /me/accounts).
FACEBOOK_PAGE_ID=
# Alias público de la página (fallback si no se conoce el ID numérico).
FACEBOOK_PAGE_HANDLE=
# Instagram: la cuenta debe ser BUSINESS y estar vinculada a la página de Facebook.
# ID vía: GET /{FACEBOOK_PAGE_ID}?fields=instagram_business_account
# Scopes necesarios: instagram_basic, instagram_manage_insights
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_HANDLE=
INSTAGRAM_HASHTAGS=cabodegata,nijar,playamonsul,parquenaturalcabodegata,rodalquilar,sanjosenijar
SOCIAL_POLLING_INTERVAL_MINUTES=15
SOCIAL_LISTENING_ENABLED=true
# Poner a false SOLO cuando la verificación pase (ver runbook). true = datos sintéticos.
SOCIAL_DRY_RUN=true

# --- Chatbot ---
# openai: IA generativa con datos de la plataforma (recomendado si hay clave).
# rasa: modelo entrenado con las FAQs (sin coste por consulta).
# Cadena de fallback automática: openai → rasa → léxico.
CHATBOT_ENGINE=rasa
RASA_URL=http://rasa:5005
RASA_TIMEOUT_SECONDS=8
RASA_FALLBACK_TO_LEXICAL=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_TOKENS=400

# --- Gemelo digital: plataforma ThingsBoard municipal (vertical externa) ---
# Acceso de lectura a la plataforma IoT del DTI (banderas de playa, aforo
# del P.N. Cabo de Gata). Sin rellenar, el gemelo marca la fuente pendiente.
THINGSBOARD_BASE_URL=
THINGSBOARD_USUARIO=
THINGSBOARD_PASSWORD=
THINGSBOARD_TIMEOUT_SECONDS=12

# --- Gemelo digital: red Bettair de calidad del aire y meteorología ---
# client_id y «app password» de la organización (cloud.bettair.city → perfil).
BETTAIR_BASE_URL=https://api.v3.bettair.city
BETTAIR_CLIENT_ID=
BETTAIR_CLIENT_SECRET=
BETTAIR_TIMEOUT_SECONDS=12

# --- Google Analytics 4 ---
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# --- Almacenamiento ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage

# --- Observabilidad ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true
