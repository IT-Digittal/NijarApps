# =============================================================
# Plataforma DTI Níjar — Variables de entorno de PRODUCCIÓN (VPS OVH)
# =============================================================
# Copiar a .env en este mismo directorio (infra/ovh/) y rellenar.
# Los valores marcados con CAMBIAR son obligatorios.
# El fichero .env NO debe subirse nunca al repositorio.

# --- Despliegue (usados por docker-compose.prod.yml y Caddy) ---
DOMINIO=CAMBIAR                        # ej. dti.nijar.es (el DNS debe apuntar al VPS)
ACME_EMAIL=CAMBIAR                     # email para avisos de Let's Encrypt
POSTGRES_PASSWORD=CAMBIAR              # generar: openssl rand -base64 24
APP_VERSION=1.0.0

# --- Aplicación ---
APP_NAME="Plataforma DTI Níjar"
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Seguridad ---
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CAMBIAR
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (solo el dominio público de la plataforma) ---
CORS_ALLOWED_ORIGINS=https://CAMBIAR   # ej. https://dti.nijar.es

# --- Base de datos PostgreSQL/PostGIS ---
# La contraseña debe coincidir con POSTGRES_PASSWORD de arriba.
DATABASE_URL=postgresql+asyncpg://nijar:CAMBIAR@db:5432/nijar_dti
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_TTL_DEFAULT=300

# --- MQTT (ingesta IoT) ---
# Usuario/contraseña creados con mosquitto_passwd (ver mosquitto.prod.conf).
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USERNAME=nijar-platform
MQTT_PASSWORD=CAMBIAR
MQTT_CLIENT_ID=nijar-dti-platform
MQTT_TOPIC_SENSORS=nijar/sensors/+/observation
MQTT_TOPIC_PATTERN=nijar/sensors/+/+
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_USE_TLS=false
MQTT_RECONNECT_DELAY_MIN_SECONDS=1
MQTT_RECONNECT_DELAY_MAX_SECONDS=60

# --- Conectores externos ---
WEB_NIJAR_API_URL=
WEB_NIJAR_API_TOKEN=
APP_VIVE_NIJAR_API_URL=
APP_VIVE_NIJAR_API_TOKEN=
METEO_API_URL=
METEO_API_KEY=

# --- Social Listening ---
# Mantener SOCIAL_DRY_RUN=true hasta disponer de los tokens reales del
# Ayuntamiento (ver instrucciones en .env.example de la raíz del repo).
TWITTER_BEARER_TOKEN=
TWITTER_SEARCH_QUERY=Cabo de Gata OR Níjar OR "Playa de Mónsul" OR "Parque Natural Cabo de Gata" OR Rodalquilar OR "San José Almería"
TWITTER_MAX_RESULTS_PER_POLL=50
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_HANDLE=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_HANDLE=
INSTAGRAM_HASHTAGS=cabodegata,nijar,playamonsul,parquenaturalcabodegata,rodalquilar,sanjosenijar
SOCIAL_POLLING_INTERVAL_MINUTES=15
SOCIAL_LISTENING_ENABLED=true
SOCIAL_DRY_RUN=true

# --- Chatbot ---
# openai: IA generativa con datos de la plataforma (recomendado si hay clave).
# rasa: modelo entrenado con las FAQs (sin coste por consulta).
# Cadena de fallback automática: openai → rasa → léxico.
CHATBOT_ENGINE=rasa
RASA_URL=http://rasa:5005
RASA_TIMEOUT_SECONDS=8
RASA_FALLBACK_TO_LEXICAL=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_TOKENS=400

# --- Google Analytics 4 ---
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# --- Almacenamiento ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage

# --- Observabilidad ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true
